# Kopiera till .env.local (lokalt) och lägg in samma värden i Vercel → Settings → Environment Variables.

# Webbplatsens publika adress, utan avslutande snedstreck.
NEXT_PUBLIC_SITE_URL=https://www.example.se

# E-post från offertformuläret via Resend (https://resend.com).
RESEND_API_KEY=
# Adressen som ska ta emot förfrågningarna.
CONTACT_TO_EMAIL=
# Avsändare på en domän som är verifierad i Resend, t.ex. "Jocke N Måleri <offert@dindoman.se>".
CONTACT_FROM_EMAIL=
